rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if request.auth != null;

      allow create: if request.resource.data.keys().hasOnly([
        'name',
        'code',
        'description',
        'price',
        'isFeatured',
        'imageUrl',
        'expirationsMonths',
        'numberOfCalories',
        'unitAmount',
        'isOrganic',
        'reviews',
        'sellingCount'
      ])
      && request.resource.data.keys().hasAll([
        'name',
        'code',
        'description',
        'price',
        'isFeatured',
        'imageUrl',
        'expirationsMonths',
        'numberOfCalories',
        'unitAmount',
        'isOrganic',
        'reviews'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 120
      && request.resource.data.code is string
      && request.resource.data.code.size() > 0
      && request.resource.data.code.size() <= 64
      && request.resource.data.description is string
      && request.resource.data.description.size() <= 5000
      && request.resource.data.price is number
      && request.resource.data.price >= 0
      && request.resource.data.isFeatured is bool
      && request.resource.data.imageUrl is string
      && request.resource.data.imageUrl.size() > 0
      && request.resource.data.expirationsMonths is int
      && request.resource.data.numberOfCalories is int
      && request.resource.data.unitAmount is int
      && request.resource.data.isOrganic is bool
      && request.resource.data.reviews is list
      && (!('sellingCount' in request.resource.data.keys())
          || request.resource.data.sellingCount is int);
    }
  }
}
